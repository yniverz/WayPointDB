{% extends "base.jinja" %}

{% block page_title %}Speed map{% endblock %}
{% block subtitle %}Pick a moment to see the speed around it. Click the chart to jump between points.{% endblock %}

{% block head %}
<link rel="stylesheet" href="/static/third_party/css/leaflet.css" />
<link rel="stylesheet" href="/static/third_party/css/leaflet.fullscreen.css" />
<script src="/static/third_party/js/leaflet.js"></script>
<script src="/static/third_party/js/leaflet.fullscreen.js"></script>
<script src="https://code.highcharts.com/highcharts.js"></script>
<script src="https://code.highcharts.com/modules/broken-axis.js"></script>
<style>
    .speed-map-frame { height: 46vh; min-height: 300px; flex: none; }
    #speedChart { height: 300px; }
</style>
{% endblock %}

{% block actions %}
<div class="form-row">
    <input type="date" id="date" aria-label="Date">
    <input type="time" id="time" step="1" aria-label="Time (UTC)">
    <span class="small muted">UTC</span>
</div>
{% endblock %}

{% block content %}
<div class="map-frame speed-map-frame">
    <div id="map"></div>
    <div class="map-loading" id="map-loading" role="status"><span class="spinner"></span><span>Loading…</span></div>
</div>

<section class="panel">
    <div class="panel-header">
        <h2>Speed</h2>
        <div class="speed-legend"><span>0</span><span class="scale" id="speed-scale"></span><span>100+ km/h</span></div>
    </div>
    <div class="panel-body"><div id="speedChart"></div></div>
</section>
{% endblock %}

{% block scripts %}
<script>
(function () {
    "use strict";

    const DEFAULT_CENTER = [{{ latitude | tojson }}, {{ longitude | tojson }}];
    const DEFAULT_ZOOM = 16;
    const SPEED_STOPS = [
        { kmh: 0, color: [0, 200, 83] },
        { kmh: 15, color: [0, 184, 212] },
        { kmh: 30, color: [170, 0, 255] },
        { kmh: 50, color: [255, 193, 7] },
        { kmh: 100, color: [255, 61, 0] },
    ];

    const dateInput = document.getElementById("date");
    const timeInput = document.getElementById("time");
    const loading = document.getElementById("map-loading");

    let map, renderer, trackLayer, markerLayer, accuracyLayer, chart;
    let points = [];
    let selectedId = null;

    function speedColor(speed) {
        const kmh = Math.max(0, (speed || 0) * 3.6);
        for (let i = 1; i < SPEED_STOPS.length; i++) {
            if (kmh <= SPEED_STOPS[i].kmh) {
                const a = SPEED_STOPS[i - 1], b = SPEED_STOPS[i];
                const f = (kmh - a.kmh) / (b.kmh - a.kmh);
                const c = a.color.map((v, k) => Math.round(v + (b.color[k] - v) * f));
                return `rgb(${c[0]},${c[1]},${c[2]})`;
            }
        }
        return `rgb(${SPEED_STOPS[SPEED_STOPS.length - 1].color.join(",")})`;
    }

    function setUrlParams(params) {
        const url = new URLSearchParams(location.search);
        for (const [key, value] of Object.entries(params)) {
            if (value === null) url.delete(key);
            else url.set(key, value);
        }
        history.replaceState({}, "", `${location.pathname}?${url}`);
    }

    function themeColors() {
        const style = getComputedStyle(document.documentElement);
        return { text: style.getPropertyValue("--text-muted").trim(), grid: style.getPropertyValue("--border").trim(), accent: style.getPropertyValue("--accent").trim() };
    }

    // ---------- Data ----------

    async function load() {
        loading.classList.add("visible");
        const body = selectedId ? { point_id: selectedId } : { date: dateInput.value, time: timeInput.value.length === 5 ? timeInput.value + ":00" : timeInput.value };
        try {
            const response = await fetch(location.pathname, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body),
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const data = await response.json();
            points = data.map(r => ({ id: r.id, lat: r.lat, lng: r.lng, accuracy: r.ha, speed: r.s, altitude: r.a, timestamp: r.t }));
            draw();
        } catch (error) {
            console.error(error);
            WP.notify("Could not load points", "error");
        } finally {
            loading.classList.remove("visible");
        }
    }

    function draw() {
        trackLayer.clearLayers();
        accuracyLayer.clearLayers();
        for (let i = 0; i < points.length - 1; i++) {
            L.polyline([[points[i].lat, points[i].lng], [points[i + 1].lat, points[i + 1].lng]],
                { color: speedColor(points[i].speed), weight: 4, renderer }).addTo(trackLayer);
        }
        for (const p of points) {
            if (p.accuracy >= 5) L.circle([p.lat, p.lng], { radius: p.accuracy, stroke: false, fillColor: "#3a7bf7", fillOpacity: 0.07, renderer, interactive: false }).addTo(accuracyLayer);
        }
        updateChart();

        if (!points.length) {
            markerLayer.clearLayers();
            WP.notify("No points near this time", "info", 2500);
            return;
        }
        const keep = points.find(p => p.id == selectedId);
        select((keep || points[Math.floor(points.length / 2)]).id, false);
    }

    function select(id, mayLoadMore = true) {
        const point = points.find(p => p.id == id);
        if (!point) return;
        selectedId = point.id;

        markerLayer.clearLayers();
        const speed = point.speed == null || point.speed < 0 ? "–" : (point.speed * 3.6).toFixed(1) + " km/h";
        const day = new Date(point.timestamp).toISOString().slice(0, 10);
        L.circleMarker([point.lat, point.lng], { radius: 7, fillColor: "#d6336c", color: "#fff", weight: 2, fillOpacity: 1, renderer })
            .bindPopup(`<div class="point-popup"><dl>
                <dt>Time</dt><dd>${WP.formatDateTime(point.timestamp)}</dd>
                <dt>Speed</dt><dd>${speed}</dd>
                <dt>Altitude</dt><dd>${point.altitude == null ? "–" : point.altitude.toFixed(0) + " m"}</dd>
                <dt>Accuracy</dt><dd>${point.accuracy == null ? "–" : point.accuracy.toFixed(1) + " m"}</dd>
            </dl><a class="button sm" href="/map?point_id=${point.id}&start_date=${day}&end_date=${day}">Show on map</a></div>`)
            .addTo(markerLayer);
        map.setView([point.lat, point.lng], Math.max(map.getZoom(), DEFAULT_ZOOM));

        const iso = new Date(point.timestamp).toISOString();
        dateInput.value = iso.slice(0, 10);
        timeInput.value = iso.slice(11, 19);
        setUrlParams({ point_id: point.id, date: null, time: null });

        if (chart) {
            chart.xAxis[0].removePlotLine("selected");
            chart.xAxis[0].addPlotLine({ id: "selected", color: "#d6336c", width: 2, value: Date.parse(point.timestamp), zIndex: 5 });
        }

        // Near the ends of the loaded window, load the window around the new point.
        const index = points.indexOf(point);
        if (mayLoadMore && (index < 10 || index > points.length - 10)) load();
    }

    // ---------- Chart ----------

    function initChart() {
        const c = themeColors();
        chart = Highcharts.chart("speedChart", {
            chart: { backgroundColor: "transparent", zooming: { type: "x" }, panning: { enabled: true, type: "x" }, panKey: "ctrl", style: { fontFamily: "inherit" } },
            credits: { enabled: false },
            title: { text: null },
            legend: { enabled: false },
            xAxis: { type: "datetime", breaks: [], lineColor: c.grid, tickColor: c.grid, labels: { style: { color: c.text } } },
            yAxis: { title: { text: null }, gridLineColor: c.grid, labels: { format: "{value} km/h", style: { color: c.text } } },
            tooltip: { xDateFormat: "%Y-%m-%d %H:%M:%S UTC", valueSuffix: " km/h" },
            plotOptions: {
                series: {
                    color: c.accent,
                    connectNulls: false,
                    turboThreshold: 0,
                    marker: { radius: 3 },
                    cursor: "pointer",
                    point: { events: { click() { select(this.id); } } },
                },
            },
            series: [{ name: "Speed", data: [] }],
        });
    }

    // Gaps longer than a few minutes are compressed so the chart stays readable.
    function updateChart() {
        if (!chart) return;
        const MAX_GAP = 3 * 60 * 1000, BREAK_SIZE = 5 * 60 * 1000;
        const data = [], breaks = [];
        let previous = null;
        for (const p of points) {
            const t = Date.parse(p.timestamp);
            if (previous && t - previous > MAX_GAP) {
                breaks.push({ from: previous, to: t - 1, breakSize: BREAK_SIZE });
                data.push({ x: previous + 1, y: null });
            }
            data.push({ x: t, y: p.speed == null || p.speed < 0 ? null : +(p.speed * 3.6).toFixed(1), id: p.id });
            previous = t;
        }
        chart.series[0].setData(data, false);
        chart.xAxis[0].update({ breaks }, false);
        chart.redraw();
    }

    document.addEventListener("themechange", () => {
        if (!chart) return;
        const c = themeColors();
        chart.update({
            xAxis: { lineColor: c.grid, tickColor: c.grid, labels: { style: { color: c.text } } },
            yAxis: { gridLineColor: c.grid, labels: { style: { color: c.text } } },
            plotOptions: { series: { color: c.accent } },
        });
    });

    // ---------- Setup ----------

    document.addEventListener("DOMContentLoaded", () => {
        const scale = SPEED_STOPS.map((stop, i) => `rgb(${stop.color.join(",")}) ${i / (SPEED_STOPS.length - 1) * 100}%`).join(", ");
        document.getElementById("speed-scale").style.background = `linear-gradient(90deg, ${scale})`;

        const params = new URLSearchParams(location.search);
        const lat = parseFloat(params.get("lat")), lng = parseFloat(params.get("lng")), zoom = parseInt(params.get("zoom"), 10);
        renderer = L.canvas({ padding: 0.5 });
        map = L.map("map", { preferCanvas: true }).setView(isNaN(lat) || isNaN(lng) ? DEFAULT_CENTER : [lat, lng], isNaN(zoom) ? DEFAULT_ZOOM : zoom);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { attribution: "&copy; OpenStreetMap contributors", maxZoom: 19 }).addTo(map);
        L.control.fullscreen().addTo(map);
        accuracyLayer = L.layerGroup().addTo(map);
        trackLayer = L.layerGroup().addTo(map);
        markerLayer = L.layerGroup().addTo(map);
        map.on("moveend", () => {
            const center = map.getCenter();
            setUrlParams({ lat: center.lat.toFixed(6), lng: center.lng.toFixed(6), zoom: map.getZoom() });
        });
        new ResizeObserver(() => map.invalidateSize()).observe(document.getElementById("map"));

        if (window.Highcharts) initChart();
        else WP.notify("The speed chart could not be loaded", "error");

        selectedId = params.get("point_id");
        const now = new Date().toISOString();
        dateInput.value = params.get("date") || now.slice(0, 10);
        timeInput.value = params.get("time") || now.slice(11, 19);

        const onPick = () => {
            selectedId = null;
            setUrlParams({ point_id: null, date: dateInput.value, time: timeInput.value });
            load();
        };
        dateInput.addEventListener("change", onPick);
        timeInput.addEventListener("change", onPick);

        load();
    });
})();
</script>
{% endblock %}
