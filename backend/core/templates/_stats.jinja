{# Building blocks shared by the statistics overview and the yearly statistics page. #}

{% macro place_items(places, last_visits, is_photon_connected) %}
    {% for place in places %}
        {% set name = place[0] ~ (", " ~ place[1] if place[1] else "") if place is not string else place %}
        {% set query = (place[0] ~ "," ~ (place[1] or "")) if place is not string else place %}
        <li>
            {% if is_photon_connected %}
                <a href="{{ url_for('web.map') }}?q={{ query | urlencode }}">{{ name }}</a>
            {% else %}
                <span>{{ name }}</span>
            {% endif %}
            {% set last = last_visits.get(place) %}
            {% if last %}<span class="when">{{ last }}</span>{% endif %}
        </li>
    {% else %}
        <li class="muted">None yet</li>
    {% endfor %}
{% endmacro %}

{% macro place_modal(id, title, places, last_visits, is_photon_connected) %}
<div class="modal fade" id="{{ id }}" tabindex="-1" aria-labelledby="{{ id }}-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="{{ id }}-title">{{ title }} <span class="muted">({{ places|length }})</span></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul class="place-list">{{ place_items(places, last_visits, is_photon_connected) }}</ul>
                <p class="muted small mt-3">Dates show the last visit.</p>
            </div>
        </div>
    </div>
</div>
{% endmacro %}

{% macro place_counts(prefix, data, show) %}
    {% if show %}
    <span>
        <button type="button" class="button ghost sm" data-bs-toggle="modal" data-bs-target="#{{ prefix }}-countries">{{ data.countries|length }} countries</button>
        <button type="button" class="button ghost sm" data-bs-toggle="modal" data-bs-target="#{{ prefix }}-cities">{{ data.cities|length }} cities</button>
    </span>
    {% endif %}
{% endmacro %}

{% macro bar_chart_script(data, labels) %}
<script src="/static/third_party/js/chart.js"></script>
<script>
    (function () {
        const datasets = {{ data | tojson }};
        const labels = {{ labels | tojson }};
        const charts = [];

        function colors() {
            const style = getComputedStyle(document.documentElement);
            return {
                accent: style.getPropertyValue("--accent").trim(),
                muted: style.getPropertyValue("--text-muted").trim(),
                grid: style.getPropertyValue("--border").trim(),
            };
        }

        function build() {
            const c = colors();
            charts.forEach(chart => chart.destroy());
            charts.length = 0;
            for (const [key, entry] of Object.entries(datasets)) {
                const canvas = document.getElementById("chart-" + key);
                if (!canvas) continue;
                charts.push(new Chart(canvas, {
                    type: "bar",
                    data: {
                        labels: labels,
                        datasets: [{ label: "Distance", data: entry.monthly_distances, backgroundColor: c.accent, borderRadius: 3, maxBarThickness: 28 }],
                    },
                    options: {
                        maintainAspectRatio: false,
                        animation: false,
                        scales: {
                            x: { grid: { display: false }, ticks: { color: c.muted, font: { size: 11 } } },
                            y: { beginAtZero: true, grid: { color: c.grid }, border: { display: false }, ticks: { color: c.muted, font: { size: 11 }, callback: v => v + " km" } },
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: { callbacks: { label: item => ` ${item.formattedValue} km` } },
                        },
                    },
                }));
            }
        }

        document.addEventListener("DOMContentLoaded", build);
        document.addEventListener("themechange", () => { if (charts.length) build(); });
    })();
</script>
{% endmacro %}
