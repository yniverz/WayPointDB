{% extends "base.jinja" %}
{% from "_stats.jinja" import place_modal, place_counts, bar_chart_script %}

{% block page_title %}{{ year }}{% endblock %}
{% block subtitle %}<a href="{{ url_for('web.stats') }}">Statistics</a> / {{ year }}{% endblock %}
{% block actions %}
    <a class="button icon" href="{{ url_for('web.yearly_stats', year=year - 1) }}" aria-label="Previous year">‹</a>
    <a class="button icon" href="{{ url_for('web.yearly_stats', year=year + 1) }}" aria-label="Next year">›</a>
    <a class="button" href="{{ url_for('web.map') }}?start_date={{ year }}-01-01&end_date={{ year }}-12-31">Show on map</a>
{% endblock %}

{% block content %}
{% set show_places = is_photon_connected or total_cities|length > 0 or total_countries|length > 0 %}
<div class="stat-grid">
    <div class="panel stat">
        <div class="stat-value">{{ total_distance }} km</div>
        <div class="stat-label">Distance in {{ year }}</div>
    </div>
    <div class="panel stat">
        <div class="stat-value">{{ total_points }}</div>
        <div class="stat-label">Points</div>
    </div>
    {% if show_places %}
    <button type="button" class="panel stat" data-bs-toggle="modal" data-bs-target="#year-countries">
        <div class="stat-value">{{ total_countries|length }}</div>
        <div class="stat-label">Countries visited</div>
    </button>
    <button type="button" class="panel stat" data-bs-toggle="modal" data-bs-target="#year-cities">
        <div class="stat-value">{{ total_cities|length }}</div>
        <div class="stat-label">Cities visited</div>
    </button>
    {% endif %}
</div>

{% if stats_by_month %}
<div class="chart-grid">
    {% for month, data in stats_by_month.items() %}
    {% set next_month = "%04d-%02d-01"|format(year + 1, 1) if month == 12 else "%04d-%02d-01"|format(year, month + 1) %}
    <section class="panel chart-card">
        <div class="panel-header">
            <div>
                <h2>{{ month|month_name }}</h2>
                <p>{{ "{:,}".format(data.total_distance) }} km</p>
            </div>
            <div class="page-actions">
                {{ place_counts("month-" ~ month, data, show_places) }}
                <a class="button sm" href="{{ url_for('web.map') }}?start_date={{ '%04d-%02d-01'|format(year, month) }}&end_date={{ next_month }}">Map</a>
            </div>
        </div>
        <div class="panel-body" style="height: 230px;"><canvas id="chart-{{ month }}" aria-label="Distance per day in {{ month|month_name }}" role="img"></canvas></div>
    </section>
    {% if show_places %}
        {{ place_modal("month-" ~ month ~ "-countries", "Countries in " ~ (month|month_name) ~ " " ~ year, data.countries|sort, last_visit_countries, is_photon_connected) }}
        {{ place_modal("month-" ~ month ~ "-cities", "Cities in " ~ (month|month_name) ~ " " ~ year, data.cities|sort, last_visit_cities, is_photon_connected) }}
    {% endif %}
    {% endfor %}
</div>
{% else %}
<section class="panel"><div class="empty">No statistics for {{ year }}.</div></section>
{% endif %}

{% if show_places %}
    {{ place_modal("year-countries", "Countries in " ~ year, total_countries, last_visit_countries, is_photon_connected) }}
    {{ place_modal("year-cities", "Cities in " ~ year, total_cities, last_visit_cities, is_photon_connected) }}
{% endif %}
{% endblock %}

{% block scripts %}
{{ bar_chart_script(stats_by_month, range(1, 32)|list) }}
{% endblock %}
