{%- from "_macros.jinja" import icon, nav_link with context -%}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="/static/images/favicon.png">
    <title>{% block title %}{{ self.page_title() | striptags | trim }}{% endblock %} · WayPointDB</title>

    <script>
        // Applied before first paint so the page never flashes in the wrong theme.
        (function () {
            var theme = "auto";
            try { theme = localStorage.getItem("theme") || "auto"; } catch (e) {}
            var dark = theme === "dark" || (theme === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches);
            document.documentElement.setAttribute("data-bs-theme", dark ? "dark" : "light");
        })();
    </script>

    <link href="/static/third_party/css/bootstrap.min.css" rel="stylesheet">
    <link href="/static/css/app.css?v={{ VERSION }}" rel="stylesheet">
    {% block head %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">

{% if current_user is not none %}
    <div class="backdrop" data-src="{{ url_for('web.full_bleed_background', v=VERSION) }}" aria-hidden="true"></div>

    <div class="app">
        <header class="topbar">
            <button class="button ghost icon" type="button" data-sidebar-toggle aria-label="Open menu">{{ icon("menu") }}</button>
            <a class="sidebar-brand" href="{{ url_for('web.home') }}"><img src="/static/images/favicon.png" alt="">WayPointDB</a>
        </header>

        <nav class="sidebar" aria-label="Main">
            <a class="sidebar-brand" href="{{ url_for('web.home') }}"><img src="/static/images/favicon.png" alt="">WayPointDB</a>

            {% if g.get('available_traces') %}
            <div class="trace-switch">
                <label for="traceSelect">Viewing</label>
                <select id="traceSelect" class="w-100">
                    <option value="" {% if g.current_trace is none %}selected{% endif %}>Main trace</option>
                    {% for trace in g.available_traces %}
                        <option value="{{ trace.id }}" {% if g.current_trace is not none and trace.id == g.current_trace.id %}selected{% endif %}>{{ trace.name }}</option>
                    {% endfor %}
                </select>
            </div>
            {% endif %}

            <div class="nav-section">
                <div class="nav-section-title">Explore</div>
                {{ nav_link("web.map", "Map", "map") }}
                {{ nav_link("web.speed_map", "Speed map", "speed") }}
                {{ nav_link("web.stats", "Statistics", "stats") }}
                {{ nav_link("web.points", "Points", "points") }}
            </div>

            <div class="nav-section">
                <div class="nav-section-title">Data</div>
                {{ nav_link("web.imports", "Imports", "upload") }}
                {{ nav_link("web.exports", "Export", "download") }}
                {{ nav_link("web.jobs", "Jobs", "jobs") }}
                {{ nav_link("web.manage_traces", "Traces", "traces") }}
            </div>

            <div class="nav-section">
                <div class="nav-section-title">Settings</div>
                {{ nav_link("web.account", "Account", "account") }}
                {% if current_user.is_admin %}
                    {{ nav_link("web.manage_users", "Users", "users") }}
                {% endif %}
            </div>

            <div class="sidebar-footer">
                <div class="sidebar-user" title="{{ current_user.email }}">{{ icon("account") }}<span>{{ current_user.email }}</span></div>
                <div class="sidebar-actions">
                    <button class="button sm" type="button" data-theme-toggle>{{ icon("theme") }}Theme</button>
                    <a class="button sm" href="{{ url_for('web.logout') }}">{{ icon("logout") }}Log out</a>
                </div>
                <div class="version"><span id="versionText">{{ VERSION }}</span></div>
            </div>
        </nav>
        <div class="sidebar-scrim" data-sidebar-toggle></div>

        <main class="main">
            <div class="content">
                <div class="page-header">
                    <div>
                        <h1>{% block page_title %}{% endblock %}</h1>
                        {% if self.subtitle() | trim %}<p class="subtitle">{% block subtitle %}{% endblock %}</p>{% endif %}
                    </div>
                    <div class="page-actions">{% block actions %}{% endblock %}</div>
                </div>
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
{% else %}
    {# Shows the backdrop of the last user who logged in on this browser, if they allowed it. #}
    <div class="backdrop" data-cached aria-hidden="true"></div>
    {% block standalone %}{% endblock %}
{% endif %}

    <script src="/static/third_party/js/bootstrap.bundle.min.js"></script>
    <script src="/static/js/app.js?v={{ VERSION }}"></script>
    {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            for (const [category, message] of {{ messages | tojson }}) {
                WP.notify(message, category === "message" ? "success" : category);
            }
        });
    </script>
    {% endif %}
    {% endwith %}
    {% block scripts %}{% endblock %}
</body>
</html>
