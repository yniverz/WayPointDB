{% extends "base.jinja" %}
{% from "_macros.jinja" import icon %}

{% macro pagination() %}
    {% if max_pages > 1 %}
    <nav class="pager" aria-label="Pages">
        <button type="button" class="button sm" data-page="{{ current_page - 1 }}" {% if current_page <= 1 %}disabled{% endif %} aria-label="Previous page">{{ icon("left") }}</button>
        {% set window = [1] + range([2, current_page - 2]|max, [max_pages, current_page + 2]|min + 1)|list + [max_pages] %}
        {% set ns = namespace(last=0) %}
        {% for page in window|unique|sort %}
            {% if page - ns.last > 1 %}<span class="muted">…</span>{% endif %}
            <button type="button" class="button sm {% if page == current_page %}primary{% endif %}" data-page="{{ page }}" {% if page == current_page %}aria-current="page"{% endif %}>{{ page }}</button>
            {% set ns.last = page %}
        {% endfor %}
        <button type="button" class="button sm" data-page="{{ current_page + 1 }}" {% if current_page >= max_pages %}disabled{% endif %} aria-label="Next page">{{ icon("right") }}</button>
    </nav>
    {% endif %}
{% endmacro %}

{% block page_title %}Points{% endblock %}
{% block subtitle %}Inspect and delete individual points of a day or an import.{% endblock %}

{% block head %}
<style>
    .pager { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
    .toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
    .toolbar .spacer { flex: 1; }
</style>
{% endblock %}

{% block content %}
<section class="panel">
    <div class="panel-header toolbar">
        <div class="toolbar">
            <button type="button" class="button icon" id="prev-day" aria-label="Previous day">{{ icon("left") }}</button>
            <input type="date" id="date-input" aria-label="Day">
            <button type="button" class="button icon" id="next-day" aria-label="Next day">{{ icon("right") }}</button>
            <button type="button" class="button sm" id="today">Today</button>
        </div>
        <div class="toolbar">
            <label for="import-select" class="small muted">Show</label>
            <select id="import-select">
                <option value="">Points of the selected day</option>
                {% for imp in imports %}
                    <option value="{{ imp.id }}" {% if request.args.get('importid') == imp.id|string %}selected{% endif %}>All points of {{ imp.name }}</option>
                {% endfor %}
            </select>
        </div>
    </div>

    <form method="POST" id="points-form" data-confirm="Delete the selected points? This cannot be undone."
          action="{{ url_for('web.points', date=request.args.get('date', ''), importid=request.args.get('importid', ''), per_page=per_page, page=current_page) }}">
        <input type="hidden" name="action" value="batch_delete">
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th class="check"><input type="checkbox" id="select-all" aria-label="Select all points on this page"></th>
                        <th>Time</th>
                        <th class="num">Latitude</th>
                        <th class="num">Longitude</th>
                        <th class="num">Speed</th>
                    </tr>
                </thead>
                <tbody>
                    {% for point in points %}
                    {% set date = point.timestamp.strftime("%Y-%m-%d") %}
                    <tr>
                        <td class="check"><input type="checkbox" name="selected_points" value="{{ point.id }}" aria-label="Select point"></td>
                        <td><a href="{{ url_for('web.map') }}?point_id={{ point.id }}&start_date={{ date }}&end_date={{ date }}" class="mono">{{ point.timestamp.strftime("%Y-%m-%d %H:%M:%S") }}</a></td>
                        <td class="num">{{ "%.6f"|format(point.latitude) }}</td>
                        <td class="num">{{ "%.6f"|format(point.longitude) }}</td>
                        <td class="num">{% if point.speed is not none and point.speed >= 0 %}{{ "%.1f"|format(point.speed * 3.6) }} km/h{% else %}<span class="muted">–</span>{% endif %}</td>
                    </tr>
                    {% else %}
                    <tr><td colspan="5" class="empty">No points for this selection.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="panel-footer">
            <div class="toolbar">
                <button type="submit" class="button sm danger" id="delete-selected" disabled>{{ icon("trash") }}Delete selected</button>
                <label for="per-page" class="small muted">Per page</label>
                <select id="per-page">
                    {% for n in [10, 20, 50, 150] %}
                        <option value="{{ n }}" {% if per_page == n %}selected{% endif %}>{{ n }}</option>
                    {% endfor %}
                </select>
            </div>
            {{ pagination() }}
        </div>
    </form>
</section>
{% endblock %}

{% block scripts %}
<script>
    function updateQueryParams(params) {
        const urlParams = new URLSearchParams(location.search);
        for (const [key, value] of Object.entries(params)) {
            if (value !== null && value !== undefined && value !== "") urlParams.set(key, value);
            else urlParams.delete(key);
        }
        location.search = urlParams.toString();
    }

    function localDateString(date) {
        return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
    }

    const dateInput = document.getElementById("date-input");
    dateInput.value = new URLSearchParams(location.search).get("date") || localDateString(new Date());

    function shiftDay(days) {
        const [y, m, d] = dateInput.value.split("-").map(Number);
        updateQueryParams({ date: localDateString(new Date(y, m - 1, d + days)), importid: null, page: 1 });
    }

    // Picking a day leaves the import view.
    dateInput.addEventListener("change", () => updateQueryParams({ date: dateInput.value, importid: null, page: 1 }));
    document.getElementById("prev-day").addEventListener("click", () => shiftDay(-1));
    document.getElementById("next-day").addEventListener("click", () => shiftDay(1));
    document.getElementById("today").addEventListener("click", () => updateQueryParams({ date: localDateString(new Date()), importid: null, page: 1 }));
    document.getElementById("import-select").addEventListener("change", event => updateQueryParams({ importid: event.target.value, page: 1 }));
    document.getElementById("per-page").addEventListener("change", event => updateQueryParams({ per_page: event.target.value, page: 1 }));
    document.querySelectorAll("[data-page]").forEach(button => {
        button.addEventListener("click", () => updateQueryParams({ page: button.dataset.page }));
    });

    const boxes = () => document.querySelectorAll('input[name="selected_points"]');
    const deleteButton = document.getElementById("delete-selected");
    function updateDeleteButton() {
        const count = [...boxes()].filter(box => box.checked).length;
        deleteButton.disabled = count === 0;
        deleteButton.lastChild.textContent = count ? `Delete ${count} selected` : "Delete selected";
    }
    document.getElementById("select-all").addEventListener("change", event => {
        boxes().forEach(box => { box.checked = event.target.checked; });
        updateDeleteButton();
    });
    boxes().forEach(box => box.addEventListener("change", updateDeleteButton));
</script>
{% endblock %}
