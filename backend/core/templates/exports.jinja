{% extends "base.jinja" %}
{% from "_macros.jinja" import icon %}

{% block page_title %}Export{% endblock %}
{% block subtitle %}Download your points as JSON.{% endblock %}

{% block content %}
<section class="panel">
    <div class="panel-body">
        <p>The export contains every point of the {% if g.current_trace %}“{{ g.current_trace.name }}” trace{% else %}main trace{% endif %} as a list of objects with
            <code>timestamp</code>, <code>latitude</code>, <code>longitude</code>, <code>horizontal_accuracy</code>,
            <code>altitude</code>, <code>vertical_accuracy</code>, <code>heading</code>, <code>heading_accuracy</code>,
            <code>speed</code>, <code>speed_accuracy</code>, <code>city</code> and <code>country</code>.
            Missing values are <code>null</code>.</p>
        <p class="muted small">The file uses the same format as imports, so it can be imported again.</p>
        <form method="POST" action="{{ url_for('web.exports') }}">
            <button type="submit" class="button primary">{{ icon("download") }}Download export</button>
        </form>
    </div>
</section>
{% endblock %}
