{%- macro icon(name) -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if name == "map" -%}<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14M15 6v14"/>
{%- elif name == "speed" -%}<path d="M12 14l4-4"/><path d="M3.3 17a9 9 0 1 1 17.4 0"/>
{%- elif name == "stats" -%}<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
{%- elif name == "points" -%}<path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r="1"/><circle cx="3.5" cy="12" r="1"/><circle cx="3.5" cy="18" r="1"/>
{%- elif name == "upload" -%}<path d="M12 15V3M7 8l5-5 5 5"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
{%- elif name == "download" -%}<path d="M12 3v12M7 10l5 5 5-5"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
{%- elif name == "jobs" -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- elif name == "traces" -%}<path d="m12 3 9 5-9 5-9-5 9-5z"/><path d="m3 13 9 5 9-5"/>
{%- elif name == "users" -%}<circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0"/><path d="M16 4a4 4 0 0 1 0 8M22 21a7 7 0 0 0-4-6.3"/>
{%- elif name == "account" -%}<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
{%- elif name == "logout" -%}<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/>
{%- elif name == "theme" -%}<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/>
{%- elif name == "menu" -%}<path d="M3 6h18M3 12h18M3 18h18"/>
{%- elif name == "left" -%}<path d="m15 18-6-6 6-6"/>
{%- elif name == "right" -%}<path d="m9 18 6-6-6-6"/>
{%- elif name == "calendar" -%}<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
{%- elif name == "trash" -%}<path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/>
{%- elif name == "plus" -%}<path d="M12 5v14M5 12h14"/>
{%- elif name == "play" -%}<path d="m7 4 13 8-13 8V4z"/>
{%- endif -%}
</svg>
{%- endmacro -%}

{%- macro nav_link(endpoint, label, icon_name) -%}
<a class="nav-link-item {% if request.endpoint == endpoint %}active{% endif %}" href="{{ url_for(endpoint) }}"
   {% if request.endpoint == endpoint %}aria-current="page"{% endif %}>{{ icon(icon_name) }}<span>{{ label }}</span></a>
{%- endmacro -%}
