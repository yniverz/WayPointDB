{% extends "base.jinja" %}
{% from "_stats.jinja" import place_modal, place_counts, bar_chart_script %}

{% block page_title %}Statistics{% endblock %}
{% block subtitle %}Based on the last run of the “Generate statistics” job.{% endblock %}
{% block actions %}<a class="button" href="{{ url_for('web.jobs') }}">Update statistics</a>{% endblock %}

{% block content %}
{% set show_places = is_photon_connected or total_cities|length > 0 or total_countries|length > 0 %}
<div class="stat-grid">
    <div class="panel stat">
        <div class="stat-value">{{ total_distance }} km</div>
        <div class="stat-label">Distance travelled</div>
    </div>
    <div class="panel stat">
        <div class="stat-value">{{ total_points }}</div>
        <div class="stat-label">Points</div>
    </div>
    {% if show_places %}
    <div class="panel stat">
        <div class="stat-value">{{ total_geocoded }}</div>
        <div class="stat-label">Geocoded <span title="Geocoded, but the server had no location for them">· {{ total_not_geocoded }} without a place</span></div>
    </div>
    <button type="button" class="panel stat" data-bs-toggle="modal" data-bs-target="#all-countries">
        <div class="stat-value">{{ total_countries|length }}</div>
        <div class="stat-label" title="Counted after more than {{ MIN_COUNTRY_VISIT_DURATION_FOR_STATS }} in a country">Countries visited</div>
    </button>
    <button type="button" class="panel stat" data-bs-toggle="modal" data-bs-target="#all-cities">
        <div class="stat-value">{{ total_cities|length }}</div>
        <div class="stat-label" title="Counted after more than {{ MIN_CITY_VISIT_DURATION_FOR_STATS }} in a city">Cities visited</div>
    </button>
    {% endif %}
</div>

{% if stats_by_year %}
<div class="chart-grid">
    {% for year, data in stats_by_year.items() %}
    <section class="panel chart-card">
        <div class="panel-header">
            <div>
                <h2><a href="{{ url_for('web.yearly_stats', year=year) }}">{{ year }}</a></h2>
                <p>{{ "{:,}".format(data.total_distance) }} km</p>
            </div>
            <div class="page-actions">
                {{ place_counts("year-" ~ year, data, show_places) }}
                <a class="button sm" href="{{ url_for('web.map') }}?start_date={{ year }}-01-01&end_date={{ year }}-12-31">Map</a>
            </div>
        </div>
        <div class="panel-body" style="height: 230px;"><canvas id="chart-{{ year }}" aria-label="Distance per month in {{ year }}" role="img"></canvas></div>
    </section>
    {% if show_places %}
        {{ place_modal("year-" ~ year ~ "-countries", "Countries in " ~ year, data.countries|sort, last_visit_countries, is_photon_connected) }}
        {{ place_modal("year-" ~ year ~ "-cities", "Cities in " ~ year, data.cities|sort, last_visit_cities, is_photon_connected) }}
    {% endif %}
    {% endfor %}
</div>
{% else %}
<section class="panel"><div class="empty">No statistics yet. Run “Generate statistics” on the <a href="{{ url_for('web.jobs') }}">Jobs</a> page.</div></section>
{% endif %}

{% if show_places %}
    {{ place_modal("all-countries", "All countries", total_countries, last_visit_countries, is_photon_connected) }}
    {{ place_modal("all-cities", "All cities", total_cities, last_visit_cities, is_photon_connected) }}
{% endif %}
{% endblock %}

{% block scripts %}
{{ bar_chart_script(stats_by_year, ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]) }}
{% endblock %}
