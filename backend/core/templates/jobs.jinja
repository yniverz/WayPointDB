{% extends "base.jinja" %}
{% from "_macros.jinja" import icon %}

{% block page_title %}Jobs{% endblock %}
{% block subtitle %}Process and clean up your data in the background. You can leave this page while jobs run.{% endblock %}

{% block head %}
<style>
    .job-list { list-style: none; margin: 0; padding: 0; }
    .job-list li {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px 20px;
        padding: 12px 0;
        border-top: 1px solid var(--border);
    }
    .job-list li:first-child { border-top: 0; padding-top: 0; }
    .job-list li:last-child { padding-bottom: 0; }
    .job-list .job-name { font-weight: 600; }
    .job-list .job-desc { color: var(--text-muted); font-size: 0.86rem; max-width: 520px; }
    .job-run { display: flex; align-items: center; gap: 8px; }
    .job-run input { width: 90px; }
    .job-group + .job-group { margin-top: 22px; }
    .job-group h3 { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 10px; }
    .job-detail { font-size: 0.82rem; color: var(--text-muted); margin-top: 2px; }
    .job-detail.error { color: var(--danger); }
</style>
{% endblock %}

{% block content %}
<section class="panel">
    <div class="panel-header">
        <div>
            <h2>Activity</h2>
            <p>Running, queued and recently finished jobs.</p>
        </div>
    </div>
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Job</th>
                    {% if current_user.is_admin %}<th>User</th>{% endif %}
                    <th>Status</th>
                    <th>Progress</th>
                    <th>Time</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="jobs-tbody"></tbody>
        </table>
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <h2>Run a job</h2>
            <p>Each job can only be queued once at a time.</p>
        </div>
    </div>
    <div class="panel-body">
        {% for group, infos in job_groups.items() %}
        <div class="job-group">
            <h3>{{ group }}</h3>
            <ul class="job-list">
                {% for info in infos %}
                <li>
                    <div>
                        <div class="job-name">{{ info.label }}</div>
                        <div class="job-desc">{{ info.description }}</div>
                    </div>
                    <form class="job-run" data-job="{{ info.name }}">
                        {% if info.param %}
                            <label class="small muted" for="run-{{ info.name }}">{{ info.param.label }}</label>
                            <input type="number" id="run-{{ info.name }}" name="{{ info.param.name }}" value="{{ info.param.default }}" min="0" step="any" required>
                            <span class="small muted">{{ info.param.unit }}</span>
                        {% endif %}
                        <button type="submit" class="button sm">{{ icon("play") }}Run</button>
                    </form>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endfor %}
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <h2>Schedule</h2>
            <p>Enabled jobs run once a day at the chosen hour (server time, currently {{ server_time }}).</p>
        </div>
    </div>
    <form method="POST">
        <input type="hidden" name="saveSchedules" value="1">
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th class="check">On</th>
                        <th>Job</th>
                        <th>Time</th>
                        <th>Setting</th>
                        <th>Last run</th>
                    </tr>
                </thead>
                <tbody>
                    {% for schedule in schedules %}
                    {% set info = schedule.info %}
                    <tr>
                        <td class="check"><input type="checkbox" name="enabled_{{ info.name }}" aria-label="Schedule {{ info.label }}" {% if schedule.enabled %}checked{% endif %}></td>
                        <td>{{ info.label }}</td>
                        <td>
                            <select name="hour_{{ info.name }}" aria-label="Hour for {{ info.label }}">
                                {% for hour in range(24) %}
                                    <option value="{{ hour }}" {% if hour == schedule.hour %}selected{% endif %}>{{ "%02d:00" % hour }}</option>
                                {% endfor %}
                            </select>
                        </td>
                        <td>
                            {% if info.param %}
                                <input type="number" name="param_{{ info.name }}" value="{{ schedule.param_value }}" min="0" step="any" style="width: 90px;" aria-label="{{ info.param.label }}">
                                <span class="small muted">{{ info.param.unit }}</span>
                            {% endif %}
                        </td>
                        <td class="muted">{{ schedule.last_run_date or "Never" }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="panel-footer">
            <span class="small muted">Changes apply from the next matching hour.</span>
            <button type="submit" class="button primary">Save schedule</button>
        </div>
    </form>
</section>
{% endblock %}

{% block scripts %}
<script>
    const showUser = {{ current_user.is_admin | tojson }};
    const tbody = document.getElementById("jobs-tbody");
    const STATUS_LABELS = { queued: "Queued", running: "Running", done: "Done", failed: "Failed", cancelled: "Cancelled" };

    function cell(content, className) {
        const td = document.createElement("td");
        if (className) td.className = className;
        if (content instanceof Node) td.appendChild(content);
        else td.textContent = content;
        return td;
    }

    function renderJobs(jobs) {
        tbody.replaceChildren();
        if (!jobs.length) {
            const td = cell("No jobs yet. Start one below.", "empty");
            td.colSpan = showUser ? 6 : 5;
            tbody.appendChild(document.createElement("tr")).appendChild(td);
            return;
        }

        for (const job of jobs) {
            const row = document.createElement("tr");

            const name = document.createElement("div");
            name.append(Object.assign(document.createElement("div"), { textContent: job.label }));
            const detail = job.error || job.message;
            if (detail) {
                name.append(Object.assign(document.createElement("div"), {
                    className: "job-detail" + (job.error ? " error" : ""),
                    textContent: detail,
                }));
            }
            row.appendChild(cell(name));
            if (showUser) row.appendChild(cell(job.user || "–", "muted"));

            const status = job.stopping ? "Stopping" : STATUS_LABELS[job.status];
            row.appendChild(cell(Object.assign(document.createElement("span"), {
                className: "badge-status " + job.status,
                textContent: status,
            })));

            if (job.status === "running") {
                const track = Object.assign(document.createElement("div"), { className: "progress-bar-track", title: `${(job.progress * 100).toFixed(1)}%` });
                track.appendChild(Object.assign(document.createElement("div"), { className: "progress-bar-fill" })).style.width = `${job.progress * 100}%`;
                row.appendChild(cell(track));
            } else {
                row.appendChild(cell(""));
            }

            let time = "";
            if (job.status === "running") {
                time = WP.formatDuration(job.elapsed) + (job.remaining != null ? ` · ~${WP.formatDuration(job.remaining)} left` : "");
            } else if (job.finished_ago != null) {
                time = `${WP.formatDuration(job.finished_ago)} ago` + (job.elapsed ? `, took ${WP.formatDuration(job.elapsed)}` : "");
            }
            row.appendChild(cell(time, "muted small nowrap"));

            const actions = cell("", "actions");
            if ((job.status === "queued" || job.status === "running") && !job.stopping) {
                const cancel = Object.assign(document.createElement("button"), { className: "button sm danger", textContent: "Cancel", type: "button" });
                cancel.addEventListener("click", () => WP.postForm(location.pathname, { cancelJob: job.id }).then(refresh).catch(() => {}));
                actions.appendChild(cancel);
            }
            row.appendChild(actions);

            tbody.appendChild(row);
        }
    }

    function refresh() {
        return fetch(location.pathname + "?update=1")
            .then(response => response.json())
            .then(renderJobs)
            .catch(error => console.error("Could not refresh jobs:", error));
    }

    document.querySelectorAll("form.job-run").forEach(form => {
        form.addEventListener("submit", event => {
            event.preventDefault();
            const fields = { newJob: form.dataset.job, ...Object.fromEntries(new FormData(form)) };
            const button = form.querySelector("button");
            button.disabled = true;
            WP.postForm(location.pathname, fields)
                .then(() => {
                    WP.notify(`${form.closest("li").querySelector(".job-name").textContent} queued`, "success", 3000);
                    return refresh();
                })
                .catch(() => {})
                .finally(() => { button.disabled = false; });
        });
    });

    renderJobs({{ jobs | tojson }});
    // Only poll while the tab is visible.
    setInterval(() => { if (!document.hidden) refresh(); }, 2000);
</script>
{% endblock %}
