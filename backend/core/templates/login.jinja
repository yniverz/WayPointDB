{% extends "base.jinja" %}

{% block page_title %}Log in{% endblock %}

{% block standalone %}
<main class="auth">
    <div class="panel auth-card">
        <div class="sidebar-brand"><img src="/static/images/favicon.png" alt="">WayPointDB</div>
        <form method="POST" class="form-stack" style="max-width: none;">
            {% if error %}<div class="alert-inline" role="alert">{{ error }}</div>{% endif %}
            <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" value="{{ email or '' }}" autocomplete="username" required autofocus>
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
            <button type="submit" class="button primary">Log in</button>
        </form>
    </div>
</main>
{% endblock %}
