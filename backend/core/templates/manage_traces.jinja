{% extends "base.jinja" %}
{% from "_macros.jinja" import icon %}

{% macro user_picker(trace_id, label) %}
    {% if can_list_users %}
        <select name="user_id" required aria-label="{{ label }}">
            <option value="">Choose a user…</option>
            {% for u_id, email in users %}
                {% if u_id != current_user_id %}<option value="{{ u_id }}">{{ email }}</option>{% endif %}
            {% endfor %}
        </select>
    {% else %}
        <input type="email" name="user_email" placeholder="user@example.com" required aria-label="{{ label }}">
    {% endif %}
{% endmacro %}

{% block page_title %}Traces{% endblock %}
{% block subtitle %}Separate timelines next to your main trace, e.g. for a car or another device. Switch between them in the sidebar.{% endblock %}

{% block content %}
{% for trace in available_traces %}
    {% set shared = [] %}
    {% for sid in trace.share_with_list %}
        {% for (u_id, email) in users %}
            {% if sid == u_id and current_user_id != u_id %}{% set _ = shared.append((u_id, email)) %}{% endif %}
        {% endfor %}
    {% endfor %}
<section class="panel">
    <div class="panel-header">
        <div>
            <h2>{{ trace.name }}</h2>
            {% if trace.description %}<p>{{ trace.description }}</p>{% endif %}
        </div>
        <form method="POST" data-confirm="Delete “{{ trace.name }}” with all its points, imports and API keys? This cannot be undone.">
            <input type="hidden" name="action" value="remove_trace">
            <input type="hidden" name="trace_id" value="{{ trace.id }}">
            <button type="submit" class="button sm danger">{{ icon("trash") }}Delete</button>
        </form>
    </div>
    <div class="panel-body">
        <div class="field">
            <span class="field-label">Shared with</span>
            {% if shared %}
                <div class="button-group">
                {% for u_id, email in shared %}
                    <form method="POST" class="badge-status" style="padding-right: 3px;">
                        <input type="hidden" name="action" value="unshare_trace">
                        <input type="hidden" name="trace_id" value="{{ trace.id }}">
                        <input type="hidden" name="user_id" value="{{ u_id }}">
                        {{ email }}
                        <button type="submit" class="button ghost sm" style="min-height: 20px; padding: 0 6px;" aria-label="Stop sharing with {{ email }}" title="Stop sharing">×</button>
                    </form>
                {% endfor %}
                </div>
            {% else %}
                <span class="muted small">Only you</span>
            {% endif %}
        </div>
        <div class="grid-2">
            <form method="POST" class="field">
                <input type="hidden" name="action" value="share_trace">
                <input type="hidden" name="trace_id" value="{{ trace.id }}">
                <span class="field-label">Share with</span>
                <div class="form-row">{{ user_picker(trace.id, "User to share with") }}<button type="submit" class="button sm">Share</button></div>
            </form>
            <form method="POST" class="field" data-confirm="Give “{{ trace.name }}” to another user? You will lose access unless they share it back.">
                <input type="hidden" name="action" value="transfer_trace">
                <input type="hidden" name="trace_id" value="{{ trace.id }}">
                <span class="field-label">Transfer ownership</span>
                <div class="form-row">{{ user_picker(trace.id, "New owner") }}<button type="submit" class="button sm">Transfer</button></div>
            </form>
        </div>
    </div>
</section>
{% else %}
<section class="panel"><div class="empty">You have no traces yet.</div></section>
{% endfor %}

<section class="panel">
    <div class="panel-header"><h2>New trace</h2></div>
    <form method="POST" class="panel-body form-stack">
        <input type="hidden" name="action" value="add_trace">
        <div class="field">
            <label for="trace_name">Name</label>
            <input type="text" id="trace_name" name="name" required>
        </div>
        <div class="field">
            <label for="trace_description">Description <span class="muted">(optional)</span></label>
            <textarea id="trace_description" name="description" rows="2"></textarea>
        </div>
        <div><button type="submit" class="button primary">{{ icon("plus") }}Create trace</button></div>
    </form>
</section>
{% endblock %}
