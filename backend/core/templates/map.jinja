{% extends "base.jinja" %}
{% from "_macros.jinja" import icon %}

{% block page_title %}Map{% endblock %}
{% block body_class %}layout-full{% endblock %}

{% block head %}
<link rel="stylesheet" href="/static/third_party/css/leaflet.css" />
<link rel="stylesheet" href="/static/third_party/css/leaflet.fullscreen.css" />
<link rel="stylesheet" href="/static/third_party/css/leaflet.draw.css" />
<script src="/static/third_party/js/leaflet.js"></script>
<script src="/static/third_party/js/leaflet.fullscreen.js"></script>
<script src="/static/third_party/js/leaflet-heat.js"></script>
<script src="/static/third_party/js/leaflet.draw.js"></script>
{% endblock %}

{% block actions %}
<div class="speed-legend" id="speed-legend" title="Track color by speed">
    <span>0</span><span class="scale" id="speed-scale"></span><span>100+ km/h</span>
</div>
{% endblock %}

{% block content %}
<section class="panel map-toolbar" aria-label="Time range">
    <div class="segmented" role="group" aria-label="Range presets">
        <button type="button" data-range="today">Today</button>
        <button type="button" data-range="yesterday">Yesterday</button>
        <button type="button" data-range="week">7 days</button>
        <button type="button" data-range="month">30 days</button>
        <button type="button" data-range="all">All</button>
    </div>

    <div class="date-range">
        <button type="button" class="button icon" id="prev-range" title="Back one day" aria-label="Back one day">{{ icon("left") }}</button>
        <input type="date" id="start-date" aria-label="From">
        <span class="muted">–</span>
        <input type="date" id="end-date" aria-label="To">
        <button type="button" class="button icon" id="next-range" title="Forward one day" aria-label="Forward one day">{{ icon("right") }}</button>
    </div>

    <div class="dropdown">
        <button type="button" class="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">{{ icon("calendar") }}Month</button>
        <div class="dropdown-menu month-picker">
            <div class="form-row">
                <select id="year-select" aria-label="Year" style="flex: 1;"></select>
                <button type="button" class="button sm" id="whole-year">Whole year</button>
            </div>
            <div class="months" id="months"></div>
        </div>
    </div>

    <div id="edit-actions" class="form-row hidden" style="margin-left: auto;">
        <label class="small" for="accuracyThreshold">In the drawn rectangle, delete points less accurate than</label>
        <input type="number" id="accuracyThreshold" value="20" min="0" style="width: 80px;"> <span class="small muted">m</span>
        <button type="button" class="button sm danger" id="delete-in-rectangle">{{ icon("trash") }}Delete</button>
    </div>
</section>

<div class="map-frame">
    <div id="map"></div>
    <div class="map-loading" id="map-loading" role="status"><span class="spinner"></span><span id="map-loading-text">Loading…</span></div>
</div>
{% endblock %}

{% block scripts %}
<script>
(function () {
    "use strict";

    const INITIAL_POINT = {{ last_point | tojson }};
    const EARLIEST_YEAR = {{ (earliest_year or none) | tojson }};
    const REFETCH_DELAY = 500;
    const MAX_MARKERS = 300;
    const FAR_DISTANCE_M = 1000;
    const ACCURACY_LIMIT_M = 20;

    const SPEED_STOPS = [
        { kmh: 0, color: [0, 200, 83] },
        { kmh: 15, color: [0, 184, 212] },
        { kmh: 30, color: [170, 0, 255] },
        { kmh: 50, color: [255, 193, 7] },
        { kmh: 100, color: [255, 61, 0] },
    ];
    const TRACK_COLOR = "#3a7bf7";

    const settings = {
        interpolated: true,       // let the server thin out points for the visible area
        speedColors: true,
        connectFar: true,
        hideInaccurate: true,
        heatmap: false,
        totalMap: false,
        editMode: false,
    };

    const startInput = document.getElementById("start-date");
    const endInput = document.getElementById("end-date");
    const loading = document.getElementById("map-loading");
    const loadingText = document.getElementById("map-loading-text");

    let map, renderer, trackLayer, markerLayer, accuracyLayer, totalMapLayer, heatLayer = null;
    let drawnItems, drawControl, selectedBounds = null;
    let points = [];
    let lastBounds = null;
    let dataIsInterpolated = false;
    let fitAfterLoad = false;
    let ignoreNextMove = false;
    let fetchTimer = null;
    let requestId = 0;

    // ---------- Helpers ----------

    function distanceM(a, b) {
        const R = 6371e3, rad = Math.PI / 180;
        const dLat = (b.lat - a.lat) * rad, dLng = (b.lng - a.lng) * rad;
        const h = Math.sin(dLat / 2) ** 2 + Math.cos(a.lat * rad) * Math.cos(b.lat * rad) * Math.sin(dLng / 2) ** 2;
        return 2 * R * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
    }

    function speedColor(speed) {
        const kmh = Math.max(0, (speed || 0) * 3.6);
        for (let i = 1; i < SPEED_STOPS.length; i++) {
            if (kmh <= SPEED_STOPS[i].kmh) {
                const a = SPEED_STOPS[i - 1], b = SPEED_STOPS[i];
                const f = (kmh - a.kmh) / (b.kmh - a.kmh);
                const c = a.color.map((v, k) => Math.round(v + (b.color[k] - v) * f));
                return `rgb(${c[0]},${c[1]},${c[2]})`;
            }
        }
        const last = SPEED_STOPS[SPEED_STOPS.length - 1].color;
        return `rgb(${last[0]},${last[1]},${last[2]})`;
    }

    function isoDate(date) {
        return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
    }

    function parseDate(value) {
        const [y, m, d] = value.split("-").map(Number);
        return new Date(y, m - 1, d);
    }

    function setUrlParams(params) {
        const url = new URLSearchParams(location.search);
        for (const [key, value] of Object.entries(params)) {
            if (value === null || value === undefined) url.delete(key);
            else url.set(key, value);
        }
        history.replaceState({}, "", `${location.pathname}?${url}`);
    }

    function showLoading(text) {
        loadingText.textContent = text;
        loading.classList.add("visible");
    }

    function hideLoading() {
        loading.classList.remove("visible");
    }

    // Read a response body while reporting progress from the Content-Original-Length header.
    async function readWithProgress(response, label) {
        const total = parseInt(response.headers.get("Content-Original-Length") || "0", 10);
        if (!total || !response.body) return response.text();
        const reader = response.body.getReader();
        const chunks = [];
        let loaded = 0;
        for (;;) {
            const { done, value } = await reader.read();
            if (done) break;
            chunks.push(value);
            loaded += value.byteLength;
            showLoading(`${label} ${Math.min(100, Math.floor(loaded / total * 100))}%`);
        }
        return new TextDecoder().decode(await new Blob(chunks).arrayBuffer());
    }

    // ---------- Date range ----------

    function setRange(start, end, fit = true) {
        startInput.value = start;
        endInput.value = end;
        setUrlParams({ start_date: start, end_date: end });
        updatePresetButtons();
        loadPoints({ force: true, wholeRange: fit });
    }

    function presetRange(name) {
        const today = new Date();
        const daysAgo = n => { const d = new Date(today); d.setDate(d.getDate() - n); return isoDate(d); };
        switch (name) {
            case "today": return [isoDate(today), isoDate(today)];
            case "yesterday": return [daysAgo(1), daysAgo(1)];
            case "week": return [daysAgo(7), isoDate(today)];
            case "month": return [daysAgo(30), isoDate(today)];
            case "all": return [`${EARLIEST_YEAR || 1970}-01-01`, isoDate(today)];
        }
    }

    function updatePresetButtons() {
        document.querySelectorAll("[data-range]").forEach(button => {
            const [start, end] = presetRange(button.dataset.range);
            button.classList.toggle("active", start === startInput.value && end === endInput.value);
        });
    }

    function shiftRange(days) {
        const start = parseDate(startInput.value), end = parseDate(endInput.value);
        start.setDate(start.getDate() + days);
        end.setDate(end.getDate() + days);
        setRange(isoDate(start), isoDate(end));
    }

    function buildMonthPicker() {
        const yearSelect = document.getElementById("year-select");
        const thisYear = new Date().getFullYear();
        for (let y = thisYear; y >= (EARLIEST_YEAR || thisYear); y--) {
            yearSelect.add(new Option(y, y));
        }
        document.getElementById("whole-year").addEventListener("click", () => {
            setRange(`${yearSelect.value}-01-01`, `${yearSelect.value}-12-31`);
        });
        const months = document.getElementById("months");
        ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"].forEach((name, i) => {
            const button = Object.assign(document.createElement("button"), { type: "button", className: "button sm", textContent: name });
            button.addEventListener("click", () => {
                const y = parseInt(yearSelect.value, 10);
                setRange(isoDate(new Date(y, i, 1)), isoDate(new Date(y, i + 1, 0)));
            });
            months.appendChild(button);
        });
    }

    // ---------- Data ----------

    function scheduleLoad() {
        clearTimeout(fetchTimer);
        if (settings.interpolated) fetchTimer = setTimeout(() => loadPoints(), REFETCH_DELAY);
    }

    async function loadPoints({ force = false, wholeRange = false } = {}) {
        const bounds = map.getBounds();

        // Without thinned-out data, everything in the date range is already loaded.
        if (!force && lastBounds && (lastBounds.equals(bounds) || (!dataIsInterpolated && lastBounds.contains(bounds)))) {
            drawMarkers();
            return;
        }
        lastBounds = bounds;

        const body = { start_date: startInput.value, end_date: endInput.value, fetch_interpolated: settings.interpolated };
        if (wholeRange) {
            fitAfterLoad = true;
        } else {
            Object.assign(body, {
                ne_lat: bounds.getNorth(), ne_lng: bounds.getEast(),
                sw_lat: bounds.getSouth(), sw_lng: bounds.getWest(),
                zoom: map.getZoom(),
            });
        }

        const thisRequest = ++requestId;
        showLoading("Loading points…");
        try {
            const response = await fetch(location.pathname, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body),
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            dataIsInterpolated = (response.headers.get("Is-Interpolated") || "").toLowerCase() === "true";
            const data = JSON.parse(await readWithProgress(response, "Loading points"));
            if (thisRequest !== requestId) return;  // a newer request superseded this one

            points = data.map(r => ({ id: r.id, lat: r.lat, lng: r.lng, accuracy: r.ha, speed: r.s, altitude: r.a, timestamp: r.t }));
            drawTrack();
            drawMarkers();

            if (fitAfterLoad) {
                fitAfterLoad = false;
                if (points.length) {
                    ignoreNextMove = true;
                    map.fitBounds(L.latLngBounds(points.map(p => [p.lat, p.lng])), { padding: [30, 30], maxZoom: 17 });
                }
            }
            if (!points.length) WP.notify("No points in this time range", "info", 2500);
        } catch (error) {
            console.error("Could not load points:", error);
            WP.notify("Could not load points", "error");
        } finally {
            if (thisRequest === requestId) hideLoading();
        }
    }

    function visiblePoints() {
        return settings.hideInaccurate ? points.filter(p => p.accuracy == null || p.accuracy < ACCURACY_LIMIT_M) : points;
    }

    // ---------- Drawing ----------

    function drawTrack() {
        trackLayer.clearLayers();
        const pts = visiblePoints();
        if (pts.length < 2) return;

        // Consecutive segments with the same color are merged into one polyline.
        let current = null;
        const flush = () => {
            if (current && current.latlngs.length > 1) {
                L.polyline(current.latlngs, { color: current.color, weight: settings.speedColors ? 4 : 3, opacity: 0.9, renderer }).addTo(trackLayer);
            }
            current = null;
        };

        for (let i = 0; i < pts.length - 1; i++) {
            const a = pts[i], b = pts[i + 1];
            if (!settings.connectFar && distanceM(a, b) > FAR_DISTANCE_M) {
                flush();
                continue;
            }
            const color = settings.speedColors ? speedColor(a.speed) : TRACK_COLOR;
            if (!current || current.color !== color) {
                flush();
                current = { color, latlngs: [[a.lat, a.lng]] };
            }
            current.latlngs.push([b.lat, b.lng]);
        }
        flush();
    }

    function pointPopup(point) {
        const fmt = (value, unit, digits = 1) => value == null || value < 0 ? "–" : `${value.toFixed(digits)} ${unit}`;
        const wrapper = document.createElement("div");
        wrapper.className = "point-popup";
        wrapper.innerHTML = `
            <dl>
                <dt>Time</dt><dd>${WP.formatDateTime(point.timestamp)}</dd>
                <dt>Speed</dt><dd>${point.speed == null || point.speed < 0 ? "–" : (point.speed * 3.6).toFixed(1) + " km/h"}</dd>
                <dt>Altitude</dt><dd>${fmt(point.altitude, "m", 0)}</dd>
                <dt>Accuracy</dt><dd>${fmt(point.accuracy, "m")}</dd>
            </dl>
            <div class="button-group">
                <button type="button" class="button sm" data-action="day">Show day</button>
                <a class="button sm" href="/map/speed?point_id=${point.id}">Speed map</a>
                <button type="button" class="button sm danger" data-action="delete">Delete</button>
            </div>`;
        wrapper.querySelector('[data-action="day"]').addEventListener("click", () => {
            const day = isoDate(new Date(point.timestamp));
            setRange(day, day, false);
        });
        wrapper.querySelector('[data-action="delete"]').addEventListener("click", () => {
            if (confirm("Delete this point?")) deletePoints([point.id]);
        });
        return wrapper;
    }

    function drawMarkers() {
        markerLayer.clearLayers();
        accuracyLayer.clearLayers();
        const pts = visiblePoints();
        const highlighted = pts.find(p => p.id === INITIAL_POINT.id);

        const center = map.getCenter(), bounds = map.getBounds();
        const nearest = pts
            .filter(p => bounds.contains([p.lat, p.lng]))
            .sort((a, b) => ((a.lat - center.lat) ** 2 + (a.lng - center.lng) ** 2) - ((b.lat - center.lat) ** 2 + (b.lng - center.lng) ** 2))
            .slice(0, MAX_MARKERS);

        if (map.getZoom() > 15 || nearest.length <= 50) {
            for (const p of nearest) {
                if (p.accuracy >= 5) {
                    L.circle([p.lat, p.lng], { radius: p.accuracy, stroke: false, fillColor: TRACK_COLOR, fillOpacity: 0.08, renderer, interactive: false }).addTo(accuracyLayer);
                }
                if (p !== highlighted) addMarker(p, false);
            }
        }
        if (highlighted) addMarker(highlighted, true);
    }

    function addMarker(point, highlight) {
        L.circleMarker([point.lat, point.lng], {
            radius: highlight ? 7 : 5,
            fillColor: highlight ? "#e5484d" : TRACK_COLOR,
            color: "#ffffff",
            weight: 2,
            fillOpacity: 1,
            renderer,
        }).bindPopup(() => pointPopup(point)).addTo(markerLayer);
    }

    // ---------- Editing ----------

    async function deletePoints(ids) {
        try {
            const response = await fetch("/map", {
                method: "DELETE",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ ids }),
            });
            if (!response.ok) throw new Error(await response.text());
            map.closePopup();
            WP.notify(`Deleted ${ids.length} point${ids.length === 1 ? "" : "s"}`, "success", 2500);
            loadPoints({ force: true });
        } catch (error) {
            WP.notify("Could not delete: " + error.message, "error");
        }
    }

    function deleteInRectangle() {
        if (!selectedBounds) {
            WP.notify("Draw a rectangle on the map first", "error");
            return;
        }
        const threshold = parseFloat(document.getElementById("accuracyThreshold").value);
        const matches = points.filter(p => selectedBounds.contains([p.lat, p.lng]) && p.accuracy > (isNaN(threshold) ? Infinity : threshold));
        if (!matches.length) {
            WP.notify("No points in the rectangle match", "info");
            return;
        }
        if (confirm(`Delete ${matches.length} points in the rectangle?`)) deletePoints(matches.map(p => p.id));
    }

    function setEditMode(on) {
        settings.editMode = on;
        document.getElementById("edit-actions").classList.toggle("hidden", !on);
        if (on) {
            map.addControl(drawControl);
        } else {
            map.removeControl(drawControl);
            drawnItems.clearLayers();
            selectedBounds = null;
        }
    }

    // ---------- Overlays ----------

    async function setHeatmap(on) {
        settings.heatmap = on;
        if (!on) {
            if (heatLayer) map.removeLayer(heatLayer);
            return;
        }
        if (!heatLayer) {
            showLoading("Loading heatmap…");
            try {
                const response = await fetch("/map/heatmap_data.csv");
                const text = await readWithProgress(response, "Loading heatmap");
                const data = text.split("\n").map(line => line.split(",").map(Number))
                    .filter(pair => pair.length === 2 && !isNaN(pair[0]))
                    .map(([lat, lng]) => [lat / 10000, lng / 10000]);
                heatLayer = L.heatLayer(data);
            } catch (error) {
                WP.notify("Could not load the heatmap", "error");
                return;
            } finally {
                hideLoading();
            }
        }
        if (settings.heatmap) heatLayer.addTo(map);
    }

    function setTotalMap(on) {
        settings.totalMap = on;
        if (on) totalMapLayer.addTo(map);
        else map.removeLayer(totalMapLayer);
    }

    function layersControl() {
        const options = [
            ["interpolated", "Adapt detail to view", "Load a simplified track for the visible area and refine it when zooming"],
            ["speedColors", "Color by speed", ""],
            ["connectFar", "Connect distant points", "Draw lines across gaps larger than 1 km"],
            ["hideInaccurate", "Hide inaccurate points", `Hide points with accuracy worse than ${ACCURACY_LIMIT_M} m`],
            ["heatmap", "Heatmap", "All points of the trace as a heatmap"],
            ["totalMap", "All tracks", "Every point ever recorded, as a map layer"],
            ["editMode", "Edit mode", "Draw a rectangle to delete inaccurate points in it"],
        ];
        const Control = L.Control.extend({
            options: { position: "topright" },
            onAdd() {
                // Collapsed on small screens, where the panel would cover much of the map.
                const collapsed = window.matchMedia("(max-width: 767.98px)").matches;
                const panel = L.DomUtil.create("div", "leaflet-control map-panel" + (collapsed ? " collapsed" : ""));
                panel.innerHTML = `<button type="button" class="map-panel-title" aria-expanded="${!collapsed}">Layers</button>
                    <div class="map-panel-options">` + options.map(([key, label, title]) => `
                    <div class="form-check form-switch" title="${title}">
                        <input class="form-check-input" type="checkbox" role="switch" id="opt-${key}" ${settings[key] ? "checked" : ""}>
                        <label class="form-check-label" for="opt-${key}">${label}</label>
                    </div>`).join("") + `</div>`;
                const toggle = panel.querySelector(".map-panel-title");
                toggle.addEventListener("click", () => {
                    toggle.setAttribute("aria-expanded", String(!panel.classList.toggle("collapsed")));
                });
                panel.addEventListener("change", event => onSettingChange(event.target.id.replace("opt-", ""), event.target.checked));
                L.DomEvent.disableClickPropagation(panel);
                L.DomEvent.disableScrollPropagation(panel);
                return panel;
            },
        });
        return new Control();
    }

    function onSettingChange(key, value) {
        switch (key) {
            case "interpolated":
                settings.interpolated = value;
                loadPoints({ force: true });
                break;
            case "heatmap": setHeatmap(value); break;
            case "totalMap": setTotalMap(value); break;
            case "editMode": setEditMode(value); break;
            default:
                settings[key] = value;
                drawTrack();
                drawMarkers();
        }
        document.getElementById("speed-legend").classList.toggle("hidden", !settings.speedColors);
    }

    // ---------- Setup ----------

    function initMap() {
        const params = new URLSearchParams(location.search);
        let lat = parseFloat(params.get("lat")), lng = parseFloat(params.get("lng")), zoom = parseInt(params.get("zoom"), 10);
        if (isNaN(lat) || isNaN(lng) || isNaN(zoom)) {
            lat = INITIAL_POINT.lat;
            lng = INITIAL_POINT.lng;
            zoom = 14;
        }

        renderer = L.canvas({ padding: 0.5 });
        map = L.map("map", { preferCanvas: true }).setView([lat, lng], zoom);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: "&copy; OpenStreetMap contributors",
            maxZoom: 19,
        }).addTo(map);
        L.control.fullscreen().addTo(map);

        totalMapLayer = L.tileLayer("/tiles/{z}/{x}/{y}.png", { maxZoom: 20 });
        accuracyLayer = L.layerGroup().addTo(map);
        trackLayer = L.layerGroup().addTo(map);
        markerLayer = L.layerGroup().addTo(map);

        drawnItems = new L.FeatureGroup().addTo(map);
        drawControl = new L.Control.Draw({
            draw: { marker: false, polygon: false, polyline: false, circle: false, circlemarker: false, rectangle: true },
            edit: { featureGroup: drawnItems },
        });
        map.on(L.Draw.Event.CREATED, event => {
            drawnItems.clearLayers();
            drawnItems.addLayer(event.layer);
            selectedBounds = event.layer.getBounds();
        });

        layersControl().addTo(map);

        map.on("movestart", () => clearTimeout(fetchTimer));
        map.on("moveend", () => {
            const center = map.getCenter();
            setUrlParams({ lat: center.lat.toFixed(6), lng: center.lng.toFixed(6), zoom: map.getZoom() });
            if (ignoreNextMove) {
                ignoreNextMove = false;
                return;
            }
            if (settings.interpolated) scheduleLoad();
            else drawMarkers();
        });

        // Keep the map sized to its frame when the layout changes.
        new ResizeObserver(() => map.invalidateSize()).observe(document.getElementById("map"));
    }

    function initRange() {
        const params = new URLSearchParams(location.search);
        const start = params.get("start_date"), end = params.get("end_date");
        if (start && end) {
            startInput.value = start;
            endInput.value = end;
            updatePresetButtons();
            loadPoints({ force: true });
        } else if (params.get("view_location") === "true") {
            // Coming from a place search: show everything around that place without moving away.
            setUrlParams({ view_location: null });
            const [s, e] = presetRange("all");
            startInput.value = s;
            endInput.value = e;
            setUrlParams({ start_date: s, end_date: e });
            updatePresetButtons();
            loadPoints({ force: true });
        } else {
            const [s, e] = presetRange("today");
            setRange(s, e);
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        const scale = SPEED_STOPS.map((stop, i) => `rgb(${stop.color.join(",")}) ${i / (SPEED_STOPS.length - 1) * 100}%`).join(", ");
        document.getElementById("speed-scale").style.background = `linear-gradient(90deg, ${scale})`;

        initMap();
        buildMonthPicker();
        initRange();

        document.querySelectorAll("[data-range]").forEach(button => {
            button.addEventListener("click", () => {
                const [start, end] = presetRange(button.dataset.range);
                setRange(start, end);
            });
        });
        document.getElementById("prev-range").addEventListener("click", () => shiftRange(-1));
        document.getElementById("next-range").addEventListener("click", () => shiftRange(1));
        [startInput, endInput].forEach(input => input.addEventListener("change", () => {
            if (startInput.value && endInput.value) setRange(startInput.value, endInput.value);
        }));
        document.getElementById("delete-in-rectangle").addEventListener("click", deleteInRectangle);
    });
})();
</script>
{% endblock %}
