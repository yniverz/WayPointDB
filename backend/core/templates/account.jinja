{% extends "base.jinja" %}
{% from "_macros.jinja" import icon %}

{% block page_title %}Account{% endblock %}
{% block subtitle %}Signed in as {{ g.current_user.email }}{% endblock %}

{% block content %}
<section class="panel">
    <div class="panel-header">
        <div>
            <h2>API keys</h2>
            <p>Tracking apps send points with an API key. Each key writes to one trace.</p>
        </div>
    </div>
    {% if api_keys %}
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th>Key</th><th>Trace</th><th></th></tr>
            </thead>
            <tbody>
            {% for key, trace_id, trace_name in api_keys %}
                <tr>
                    <td><code class="mono">{{ key }}</code></td>
                    <td>{{ trace_name }}</td>
                    <td class="actions">
                        <button type="button" class="button sm" data-copy="{{ key }}">Copy</button>
                        <form method="POST" data-confirm="Delete this API key? Apps using it will stop sending points.">
                            <input type="hidden" name="api_key" value="{{ key }}">
                            <button type="submit" name="delete_key" value="1" class="button sm danger">Delete</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
        <div class="empty">You have no API keys yet.</div>
    {% endif %}
    <div class="panel-footer">
        <form method="POST" class="form-row">
            <div class="field">
                <label for="trace_id">New key for</label>
                <select id="trace_id" name="trace_id">
                    <option value="">Main trace</option>
                    {% for trace in available_traces %}
                        <option value="{{ trace.id }}">{{ trace.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit" name="generate_key" value="1" class="button primary">{{ icon("plus") }}Generate key</button>
        </form>
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <h2>Connecting a tracking app</h2>
            <p>Use one of these URLs in the app, with <code>KEY</code> replaced by an API key.</p>
        </div>
    </div>
    <div class="panel-body">
        <div class="field">
            <span class="field-label">Overland</span>
            <code>{{ request.host_url }}api/v1/gps/overland?api_key=KEY</code>
        </div>
        <div class="field">
            <span class="field-label">OwnTracks (HTTP mode)</span>
            <code>{{ request.host_url }}api/v1/gps/owntracks?api_key=KEY</code>
        </div>
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <h2>Sign-in details</h2>
            <p>Leave a field empty to keep it unchanged.</p>
        </div>
    </div>
    <form method="POST" class="panel-body form-stack">
        <div class="field">
            <label for="new_email">Email</label>
            <input type="email" id="new_email" name="new_email" placeholder="{{ g.current_user.email }}" autocomplete="email">
        </div>
        <div class="field">
            <label for="new_password">New password</label>
            <input type="password" id="new_password" name="new_password" autocomplete="new-password">
        </div>
        <div>
            <button type="submit" name="update_account" value="1" class="button primary">Save changes</button>
        </div>
    </form>
</section>
{% endblock %}

{% block scripts %}
<script>
    document.querySelectorAll("[data-copy]").forEach(button => {
        button.addEventListener("click", () => {
            navigator.clipboard.writeText(button.dataset.copy)
                .then(() => WP.notify("API key copied", "success", 2500))
                .catch(() => WP.notify("Could not copy; select the key and copy it manually", "error"));
        });
    });
</script>
{% endblock %}
