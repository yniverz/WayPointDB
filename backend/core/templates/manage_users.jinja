{% extends "base.jinja" %}
{% from "_macros.jinja" import icon %}

{% block page_title %}Users{% endblock %}
{% block subtitle %}Everyone who can sign in to this server.{% endblock %}

{% block content %}
<section class="panel">
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th>Email</th><th>Role</th><th></th></tr>
            </thead>
            <tbody>
                {% for user in users %}
                <tr>
                    <td>{{ user.email }}{% if current_user.id == user.id %} <span class="muted small">(you)</span>{% endif %}</td>
                    <td>{% if user.is_admin %}<span class="badge-status running">Admin</span>{% else %}<span class="badge-status">User</span>{% endif %}</td>
                    <td class="actions">
                        {% if current_user.id != user.id %}
                            <button type="button" class="button sm" data-reset-password="{{ user.id }}" data-email="{{ user.email }}">Set password</button>
                            <form method="POST" data-confirm="Remove {{ user.email }}? This also deletes all of their points, traces and imports and cannot be undone.">
                                <input type="hidden" name="action" value="remove_user">
                                <input type="hidden" name="user_id" value="{{ user.id }}">
                                <button type="submit" class="button sm danger">Remove</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>

<section class="panel">
    <div class="panel-header"><h2>Add a user</h2></div>
    <form method="POST" class="panel-body form-stack">
        <input type="hidden" name="action" value="add_user">
        <div class="field">
            <label for="email">Email</label>
            <input type="email" name="email" id="email" required autocomplete="off">
        </div>
        <div class="field">
            <label for="password">Password</label>
            <input type="password" name="password" id="password" required autocomplete="new-password">
        </div>
        <div class="field">
            <label for="is_admin">Role</label>
            <select name="is_admin" id="is_admin">
                <option value="false">User</option>
                <option value="true">Admin (can manage users)</option>
            </select>
        </div>
        <div><button type="submit" class="button primary">{{ icon("plus") }}Add user</button></div>
    </form>
</section>
{% endblock %}

{% block scripts %}
<script>
    document.querySelectorAll("[data-reset-password]").forEach(button => {
        button.addEventListener("click", () => {
            const password = prompt(`New password for ${button.dataset.email}:`);
            if (!password) return;
            WP.postForm(location.pathname, { action: "change_password", user_id: button.dataset.resetPassword, password })
                .then(() => WP.notify(`Password for ${button.dataset.email} changed`, "success"))
                .catch(() => {});
        });
    });
</script>
{% endblock %}
